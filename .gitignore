# ============================================
# DATA FOLDERS - DO NOT PUSH TO GITHUB
# ============================================
# User uploaded files and processed data
data/
data/raw/
data/processed/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Generated reports
reports/
reports/*
!reports/.gitkeep

# Application logs
logs/
logs/*
!logs/.gitkeep

